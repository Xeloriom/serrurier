---
const content = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "frame-src 'none'",
  "form-action 'self'",
  "script-src 'self' https://unpkg.com/leaflet@1.9.4/dist/leaflet.js https://plausible.io/js/script.js",
  "style-src 'self' https://fonts.googleapis.com https://unpkg.com",
  "style-src-attr 'unsafe-inline'",
  "font-src 'self' https://fonts.gstatic.com data:",
  "img-src 'self' data: blob: https://*.tile.openstreetmap.org",
  "connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://plausible.io https://*.tile.openstreetmap.org",
  'upgrade-insecure-requests',
].join('; ');
---
<meta http-equiv="Content-Security-Policy" content={content} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
