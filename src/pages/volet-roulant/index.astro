  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Volet roulant bloqué dans votre secteur | Dépannage" />
  <meta name="twitter:description" content="Décrivez votre volet roulant bloqué et demandez les conditions du dépannage dans votre secteur." />
  <meta name="twitter:image" content="https://xn--serrurierdpannagerapide-kcc.fr/assets/rolling-shutter.webp" />
  <meta name="twitter:image:alt" content="Volets roulants installés sur une maison" />
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Dépannage de volet roulant dans votre secteur",
      "serviceType": "Réparation de volets roulants",
      "url": "https://xn--serrurierdpannagerapide-kcc.fr/volet-roulant/",
      "areaServed": ["secteur desservi", "Est local", "Nord-Isère", "Plaine de l'Ain"],
      "provider": {
        "@type": "Locksmith",
        "@id": "https://xn--serrurierdpannagerapide-kcc.fr/#business",
        "name": "Serrurier Dépannage Rapide",
        "url": "https://xn--serrurierdpannagerapide-kcc.fr/",
        "telephone": "+33778952440"
      }
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://xn--serrurierdpannagerapide-kcc.fr/" },
        { "@type": "ListItem", "position": 2, "name": "Volets roulants", "item": "https://xn--serrurierdpannagerapide-kcc.fr/volet-roulant/" }
      ]
    }
