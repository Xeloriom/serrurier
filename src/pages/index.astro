<body class="font-sans bg-[#fcfcfc] text-[#111] overflow-x-hidden selection:bg-black selection:text-white">
<div class="scroll-progress" aria-hidden="true"><span></span></div>
<!-- Sprite d'icônes (style Lucide) -->
<svg width="0" height="0" style="position: absolute" aria-hidden="true">
  <defs>
    <symbol id="i-arrow-right" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></symbol>
    <symbol id="i-arrow-up-right" viewBox="0 0 24 24"><path d="M7 7h10v10" /><path d="M7 17 17 7" /></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="M12 5v14" /></symbol>
    <symbol id="i-key" viewBox="0 0 24 24">
      <path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4" /><path d="m21 2-9.6 9.6" /><circle cx="7.5" cy="15.5" r="5.5" />
    </symbol>
    <symbol id="i-lock" viewBox="0 0 24 24"><rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></symbol>
    <symbol id="i-shield" viewBox="0 0 24 24">
      <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
    </symbol>
    <symbol id="i-wrench" viewBox="0 0 24 24">
      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z" />
    </symbol>
    <symbol id="i-door-open" viewBox="0 0 24 24">
      <path d="M13 4h3a2 2 0 0 1 2 2v14" /><path d="M2 20h3" /><path d="M13 20h9" /><path d="M10 12v.01" />
      <path d="M13 4.562v16.157a1 1 0 0 1-1.242.97L5 20V5.562a2 2 0 0 1 1.515-1.94l4-1A2 2 0 0 1 13 4.561Z" />
    </symbol>
    <symbol id="i-phone" viewBox="0 0 24 24">
      <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" />
    </symbol>
    <symbol id="i-locksmith-mascot" viewBox="0 0 48 48">
      <defs>
        <linearGradient id="chat-mascot-helmet" x1="12" y1="7" x2="37" y2="27" gradientUnits="userSpaceOnUse">
          <stop stop-color="#F2B27D" />
          <stop offset="1" stop-color="#C87553" />
        </linearGradient>
        <linearGradient id="chat-mascot-face" x1="16" y1="20" x2="34" y2="43" gradientUnits="userSpaceOnUse">
          <stop stop-color="#FFE2C2" />
          <stop offset="1" stop-color="#E9A77F" />
        </linearGradient>
      </defs>
      <path d="M9 26c0-10 6.4-17 15-17s15 7 15 17v3H9v-3Z" fill="#3D302A" />
      <path d="M13 27c0-8 4.5-12 11-12s11 4 11 12v7c0 6.2-4.9 10-11 10s-11-3.8-11-10v-7Z" fill="url(#chat-mascot-face)" />
      <path d="M9 23c0-9.2 6.5-16 15-16s15 6.8 15 16v2H9v-2Z" fill="url(#chat-mascot-helmet)" />
      <path d="M7.5 24c0-1.6 1.2-2.8 2.8-2.8h27.4c1.6 0 2.8 1.2 2.8 2.8s-1.2 2.8-2.8 2.8H10.3c-1.6 0-2.8-1.2-2.8-2.8Z" fill="#F4C08F" />
      <path d="M11 26v4c0 1.7 1.2 3 2.8 3h.8v-7H11ZM37 26v4c0 1.7-1.2 3-2.8 3h-.8v-7H37Z" fill="#3D302A" />
      <path d="M11.2 28v2c0 1.6 1.1 2.8 2.6 2.8h.8v-4.5h-3.4ZM36.8 28v2c0 1.6-1.1 2.8-2.6 2.8h-.8v-4.5h3.4Z" fill="#E7A06F" />
      <ellipse cx="19.5" cy="31" rx="1.2" ry="1.6" fill="#38251E" />
      <ellipse cx="28.5" cy="31" rx="1.2" ry="1.6" fill="#38251E" />
      <path d="M20.5 37c2.2 2 5 2 7 0" stroke="#9A4F3A" stroke-width="1.5" stroke-linecap="round" />
      <path d="M15 28.5c1.1-.8 2.3-.8 3.4 0M26.6 28.5c1.1-.8 2.3-.8 3.4 0" stroke="#86513B" stroke-width="1.2" stroke-linecap="round" />
    </symbol>
  </defs>
</svg>

<div id="app" x-data="museum" class="relative w-full min-h-screen">
  <main>
  <!-- ================================================================ -->
  <!--  SECTION 1 — HERO                                                 -->
  <!-- ================================================================ -->
  <section id="top" class="hero-section relative w-full flex flex-col">
    <!-- Logo + sub-nav -->
    <header class="site-header relative pt-6 px-6 md:px-16 z-20" data-stagger data-delay="0" data-step="0.08">
      <div id="logo" class="logo w-[150px] sm:w-[180px] md:w-[220px] m-0" data-st>
        <span class="sr-only">Serrurier Dépannage Rapide</span>
        <svg viewBox="0 0 840 100" class="block w-full h-auto fill-[#111] overflow-hidden" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <!-- S -->
          <g transform="translate(0,0)">
            <polygon class="letter" points="0,0 214,0 214,14 0,14" />
            <polygon class="letter" points="0,14 14,14 14,50 0,50" />
            <polygon class="letter" points="0,43 214,43 214,57 0,57" />
            <polygon class="letter" points="200,50 214,50 214,86 200,86" />
            <polygon class="letter" points="0,86 214,86 214,100 0,100" />
          </g>
          <!-- D -->
          <g transform="translate(313,0)">
            <polygon class="letter" points="0,0 14,0 14,100 0,100" />
            <polygon class="letter" points="14,0 150,0 150,14 14,14" />
            <polygon class="letter" points="14,86 150,86 150,100 14,100" />
            <polygon class="letter" points="150,0 168,0 214,50 168,100 150,100 200,50" />
          </g>
          <!-- R -->
          <g transform="translate(626,0)">
            <polygon class="letter" points="0,0 14,0 14,100 0,100" />
            <polygon class="letter" points="14,0 200,0 200,14 14,14" />
            <polygon class="letter" points="200,0 214,0 214,57 200,57" />
            <polygon class="letter" points="14,43 200,43 200,57 14,57" />
            <polygon class="letter" points="110,57 143,57 214,100 181,100" />
          </g>
        </svg>
        <span class="mt-1 block text-[9px] font-mono uppercase tracking-[0.16em] text-gray-500">Serrurier Dépannage Rapide</span>
      </div>

      <div data-st class="fade-up flex justify-between items-center mt-5 md:mt-3 text-[10px] md:text-[11px] font-mono tracking-[0.12em] uppercase">
        <p class="flex-1 px-2 leading-relaxed text-gray-800 font-mono md:hidden">
          <span class="block font-semibold">Lyon &amp; alentours · Urgence 24h/24</span>
          <span class="mt-1 block text-gray-500">Serrurerie · Portes · Volets</span>
        </p>

        <nav class="hidden md:block md:flex-1" aria-label="Navigation principale">
        <ul class="flex justify-end items-center gap-4 lg:gap-6 text-gray-800 text-[10px] lg:text-[11px] font-mono uppercase tracking-wider">
          <li><a href="#top" @click.prevent="go('#top')" class="hover:text-black hover:underline">Accueil</a></li>
          <li><a href="#explore" @click.prevent="go('#explore')" class="hover:text-black hover:underline">Services</a></li>
          <li><a href="#prestations" @click.prevent="go('#prestations')" class="hover:text-black hover:underline">Prestations</a></li>
          <li><a href="#zone" @click.prevent="go('#zone')" class="hover:text-black hover:underline">Zone d'intervention</a></li>
          <li><a href="prix-serrurier-lyon/" class="hover:text-black hover:underline">Prix &amp; devis</a></li>
          <li><a href="#faq" @click.prevent="go('#faq')" class="hover:text-black hover:underline">FAQ</a></li>
          <li><a href="#contact" @click.prevent="go('#contact')" class="border border-black rounded-full px-4 py-2 hover:bg-black hover:text-white transition-colors">Contact</a></li>
        </ul>
        </nav>

        <button
                type="button"
                class="md:hidden group relative z-[60] flex flex-col items-end gap-[6px] p-2 -mr-2 cursor-pointer"
                :aria-label="menuOpen ? 'Fermer le menu' : 'Ouvrir le menu'"
                :aria-expanded="menuOpen"
                aria-controls="mobile-navigation"
                @keydown.escape.window="menuOpen = false"
                @click="menuOpen = !menuOpen"
        >
          <span class="block h-[1.5px] bg-black transition-all duration-300" :class="menuOpen ? 'w-8 rotate-45 translate-y-[3.75px]' : 'w-8 group-hover:w-6'"></span>
          <span class="block h-[1.5px] bg-black transition-all duration-300" :class="menuOpen ? 'w-8 -rotate-45 -translate-y-[3.75px]' : 'w-8 group-hover:w-10'"></span>
        </button>
      </div>

      <!-- Menu mobile -->
      <div
              x-cloak
              x-show="menuOpen"
              x-transition:enter="transition duration-300 ease-out"
              x-transition:enter-start="opacity-0 -translate-y-5"
              x-transition:enter-end="opacity-100 translate-y-0"
              x-transition:leave="transition duration-300 ease-out"
              x-transition:leave-start="opacity-100 translate-y-0"
              x-transition:leave-end="opacity-0 -translate-y-5"
              id="mobile-navigation"
              class="md:hidden absolute left-0 right-0 top-full bg-[#fcfcfc] border-b border-gray-200 shadow-xl px-6 py-10"
      >
        <nav aria-label="Navigation mobile">
        <ul class="space-y-6 text-sm font-mono tracking-[0.12em] uppercase">
          <li><a href="#explore" @click.prevent="go('#explore')" class="text-gray-800 hover:text-black hover:underline">Services</a></li>
          <li><a href="#zone" @click.prevent="go('#zone')" class="text-gray-800 hover:text-black hover:underline">Zone d'intervention</a></li>
          <li><a href="prix-serrurier-lyon/" class="text-gray-800 hover:text-black hover:underline">Prix &amp; devis</a></li>
          <li><a href="#faq" @click.prevent="go('#faq')" class="text-gray-800 hover:text-black hover:underline">Questions fréquentes</a></li>
          <li><a href="#contact" @click.prevent="go('#contact')" class="text-gray-800 hover:text-black hover:underline">Contact</a></li>
        </ul>
        </nav>
      </div>
    </header>

    <div class="hero-story relative z-10">
      <div class="hero-main">
        <article id="hero-step-1" class="hero-copy hero-step reveal" data-hero-image="0">
          <div class="flex items-center gap-4 mb-8 text-xs font-mono"><span>01</span><span class="block w-16 h-[1.5px] bg-black/20"></span></div>
          <h1 class="text-[clamp(2.3rem,10vw,3.5rem)] md:text-[4rem] font-normal tracking-tight leading-[1] mb-6">SERRURIER DÉPANNAGE <br />EN URGENCE ?</h1>
          <p class="text-[13px] md:text-[14px] text-gray-700 w-full max-w-[360px] leading-[1.6] mb-8">
            Besoin d'un serrurier à Lyon ou en périphérie ? Dépannage, ouverture de porte et réparation de serrure, de jour comme de nuit.
          </p>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href="#contact" data-phone class="group relative inline-flex overflow-hidden bg-[#1a1a1a] px-6 py-3.5 border border-[#1a1a1a] rounded-md shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[3px_3px_0px_rgba(17,17,17,0.5)]">
              <span class="absolute inset-0 bg-[#fcfcfc] -translate-x-[101%] group-hover:translate-x-0 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"></span>
              <span class="relative z-10 flex items-center gap-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-white group-hover:text-[#111] transition-colors duration-500" aria-hidden="true"><use href="#i-phone" /></svg>
                <span data-phone-action data-phone-fallback="Demander un devis" class="text-[15px] font-medium text-white group-hover:text-[#111] transition-colors duration-500">Appeler · 07 78 95 24 40</span>
              </span>
            </a>
            <a href="#details" @click.prevent="go('#details')" class="text-sm font-medium text-gray-700 underline underline-offset-4 hover:text-black">Voir les prestations</a>
          </div>
          <a href="#hero-step-2" @click.prevent="go('#hero-step-2')" class="scroll-cue mt-10 inline-flex items-center gap-3 text-[10px] font-mono tracking-widest uppercase text-gray-500">
            <span class="scroll-cue-icon flex items-center justify-center w-10 h-10 rounded-full border border-gray-300">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14" /><path d="m19 12-7 7-7-7" /></svg>
            </span>
            <span>Défiler pour découvrir</span>
          </a>
        </article>

        <article id="hero-step-2" class="hero-copy hero-step reveal" data-hero-image="1" style="--d: 0.08s">
          <div class="flex items-center gap-4 mb-8 text-xs font-mono"><span>02</span><span class="block w-16 h-[1.5px] bg-black/20"></span></div>
          <h2 class="text-[clamp(2.3rem,10vw,3.5rem)] md:text-[4rem] font-normal tracking-tight leading-[1] mb-6">UNE PORTE<br />BLOQUÉE ?</h2>
          <p class="text-[13px] md:text-[14px] text-gray-700 w-full max-w-[360px] leading-[1.6] mb-8">
            Porte claquée ou verrouillée ? Précisez si une clé est disponible et si la serrure a déjà été tournée.
          </p>
        </article>

        <article id="hero-step-3" class="hero-copy hero-step reveal" data-hero-image="2" style="--d: 0.08s">
          <div class="flex items-center gap-4 mb-8 text-xs font-mono"><span>03</span><span class="block w-16 h-[1.5px] bg-black/20"></span></div>
          <h2 class="text-[clamp(2.3rem,10vw,3.5rem)] md:text-[4rem] font-normal tracking-tight leading-[1] mb-6">LYON &amp;<br />ALENTOURS</h2>
          <p class="text-[13px] md:text-[14px] text-gray-700 w-full max-w-[360px] leading-[1.6] mb-8">
            Le déplacement se confirme au téléphone selon votre commune et les disponibilités du moment.
          </p>
        </article>
      </div>

      <div class="hero-visual reveal">
        <img
          class="hero-photo is-active"
          src="assets/locksmith-work.webp"
          alt="Serrurier en intervention sur une serrure de porte"
          data-chapter="0"
          fetchpriority="high"
          decoding="async"
          width="1280"
          height="961"
        />
        <img class="hero-photo" alt="" aria-hidden="true" width="1280" height="961" />
        <div class="hero-image-status" aria-hidden="true">
          <span class="hero-image-count"><span id="hero-image-current">01</span><span> / 03</span></span>
          <span class="hero-image-name" id="hero-image-name">Dépannage d'urgence</span>
          <span class="hero-image-progress">
            <span class="is-active"></span><span></span><span></span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================ -->
  <!--  SECTION 2 — SERVICES                                             -->
  <!-- ================================================================ -->
  <section id="explore" class="relative w-full bg-[#fcfcfc] flex flex-col items-center text-center pt-20 md:pt-28 pb-16 px-6 z-20">
    <div class="text-[10px] md:text-[11px] font-mono tracking-[0.2em] mb-12">
      [ <span class="text-gray-500">02</span> ]
      <span class="text-gray-900 font-bold uppercase">Nos services</span>
    </div>

    <h2
            class="reveal max-w-[1000px] text-[2.2rem] md:text-[3.5rem] lg:text-[4.2rem] leading-[1.1] font-medium tracking-tight text-[#111]"
            style="--y: 40px; --dur: 1s; --ease: cubic-bezier(0.16, 1, 0.3, 1)"
    >
      Quel est votre besoin ?
    </h2>

    <nav aria-label="Accès rapide à nos services" class="service-shortcuts" data-reveal-stagger data-delay="0.12" data-step="0.06">
      <div class="reveal">
        <a href="ouverture-porte-lyon/" class="service-shortcut">
          <span class="service-shortcut-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-door-open" /></svg></span><span>Ouverture de porte</span><span class="service-shortcut-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="reveal">
        <a href="serrure-porte-blindee-lyon/" class="service-shortcut">
          <span class="service-shortcut-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-shield" /></svg></span><span>Serrures &amp; sécurité</span><span class="service-shortcut-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="reveal">
        <a href="volet-roulant-lyon/" class="service-shortcut">
          <span class="service-shortcut-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-wrench" /></svg></span><span>Volets roulants</span><span class="service-shortcut-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
      <div>
        <a href="prix-serrurier-lyon/" class="service-shortcut">
          <span class="service-shortcut-icon"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-key" /></svg></span><span>Prix &amp; devis</span><span class="service-shortcut-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </nav>

    <div id="spacer" class="h-12 md:h-20"></div>

