  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Prix serrurier dans votre secteur : comparer un devis",
      "url": "https://xn--serrurierdpannagerapide-kcc.fr/prix-serrurier/",
      "about": {
        "@type": "Locksmith",
        "@id": "https://xn--serrurierdpannagerapide-kcc.fr/#business",
        "name": "Serrurier Dépannage Rapide",
        "url": "https://xn--serrurierdpannagerapide-kcc.fr/",
        "telephone": "+33778952440"
      }
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://xn--serrurierdpannagerapide-kcc.fr/" },
        { "@type": "ListItem", "position": 2, "name": "Prix et devis serrurier", "item": "https://xn--serrurierdpannagerapide-kcc.fr/prix-serrurier/" }
      ]
    }
